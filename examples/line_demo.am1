// Demo-only view transform: magnify logical points 8x around the center.
// G_LINE itself is unchanged. Eight device pixels separate adjacent points.
// This makes the integer stair steps visible without drawing long dense lines.
gplot, 0
        dac view_ret
        lac i view_ret
        sub [0d512]
        sal 3s
        add [0d512]
        dac view_x
        idx view_ret
        lac i view_ret
        sub [0d512]
        sal 3s
        add [0d512]
        dac view_y
        idx view_ret
        jda device_plot
view_x, 0
view_y, 0
        jmp i view_ret
view_ret, 0

#include "../src/gline.am1"
#define gplot device_plot
#include "../src/gplot.am1"
#undef gplot
constants
start go
