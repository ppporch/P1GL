        0d768; 0d256; 0d768; 0d768
        jda gline
        0d768; 0d768; 0d256; 0d768
        jda gline
        0d256; 0d768; 0d256; 0d256

        jda ggroup_define
        diamond; 0d32
        jsp ggroup_end
        jsp gframe_end
        sza
        hlt
restart,
        law route
        dac leg
next_leg,lac i leg
        dac x
        idx leg
        lac i leg
        dac y
        idx leg
        lac i leg
        dac dx
        idx leg
        lac i leg
        dac dy
        idx leg
        law i 0d70
        dac remaining
frame,
#ifndef DEMO_CPU_TEST
        iot 32
        dio started
#endif
