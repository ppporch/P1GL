        // Reuse the computed points in the four inline argument blocks.
        lac y
        dac left_y
        dac right_y
        dac right_y2
        dac left_y2
        lac right_x
        dac right_x2
        lac left_x
        dac left_x2
        lac top_x
        dac top_x2
        lac top_y
        dac top_y2
        lac bottom_x
        dac bottom_x2
        lac bottom_y
        dac bottom_y2
        jda gline_clip
top_x, 0
top_y, 0
right_x,0
right_y,0
        jda gline_clip
right_x2,0
right_y2,0
bottom_x,0
bottom_y,0
        jda gline_clip
bottom_x2,0
bottom_y2,0
left_x,0
left_y,0
