#define P1GL_RETAINED
100/
go,     lem
        lsm
        cbs
#ifndef DEMO_CPU_TEST
        lac [2000]
        iot 2032
#endif
        jda gview_set
        0d256; 0d256; 0d768; 0d768
        jda gframe_begin
        scene; 0d400
        jda gtext
        0d318; 0d850; 2; title
