P1GL circle demo: retained points, 8x view, edge clipping, zero radius
100/
go,     lem
        lsm
        cbs
#ifndef DEMO_CPU_TEST
        lac [2000]           // enable BBN ms clock, no clock interrupts
        iot 2032
#endif
        dzm frames
        dzm page
        law circle_table
        dac table_pointer
new_page,
        lac i table_pointer
        dac demo_cx
        idx table_pointer
        lac i table_pointer
        dac demo_cy
        idx table_pointer
        lac i table_pointer
        dac demo_r
        idx table_pointer
        dzm point_count
        law point_buffer
        dac write_pointer
        jda gcircle
demo_cx, 0
demo_cy, 0
demo_r, 0
#ifdef DEMO_CPU_TEST
        law i 1
#else
        law i 0d60
#endif
        dac repeats
frame,
#ifndef DEMO_CPU_TEST
        iot 32
        dio frame_start
#endif
        law point_buffer
        dac read_pointer
        lac point_count
        sza i
        jmp demo_fault
        cma
        dac points_left
replay,
        lio i read_pointer   // cached raw Y followed by raw X
        idx read_pointer
        lac i read_pointer
        dpy 200
        idx read_pointer
        isp points_left
        jmp replay
#ifndef DEMO_CPU_TEST
wait_frame,
        iot 32
        dio now_ms
        lac now_ms
        sub frame_start
        spa
        jmp clock_wrap
        jmp check_time
clock_wrap,
        add [0d60000]
check_time,
        sub [0d22]
        spa
        jmp wait_frame
#endif
        idx frames
        isp repeats
        jmp frame
        idx page
        sad [0d11]
        jmp restart
        jmp new_page
restart,
#ifdef DEMO_CPU_TEST
        hlt
#endif
        dzm page
        law circle_table
        dac table_pointer
        jmp new_page
demo_fault,
        law 1
        dac fault
        hlt

// Application-only point recorder; G_CIRCLE and G_PLOT stay unchanged.
// Magnify about this page's circle center; clipped points are already removed.
gplot, 0
        dac record_ret
        lac point_count
        sad [0d256]
        jmp demo_fault
        lac i record_ret
        sub demo_cx
        sal 3s
        add demo_cx
        dac gc_value
        jsp gcoord
        dac raw_x
        idx record_ret
        lac i record_ret
        sub demo_cy
        sal 3s
        add demo_cy
        dac gc_value
        jsp gcoord
        dac i write_pointer
        idx write_pointer
        lac raw_x
        dac i write_pointer
        idx write_pointer
        idx record_ret
        idx point_count
        jmp i record_ret
record_ret, 0
raw_x, 0
frames, 0
page, 0
repeats, 0
fault, 0
frame_start, 0
now_ms, 0
read_pointer, 0
write_pointer, 0
points_left, 0
point_count, 0
table_pointer, 0
circle_table,
