P1GL combined retained frame demo: labels, line, circle, center point
#define P1GL_FRAME
100/
go,     lem
        lsm
        cbs
#ifndef DEMO_CPU_TEST
        lac [2000]
        iot 2032
#endif
        dzm frames
        dzm page
        dzm max_draw_ms
        law scene_table
        dac table_pointer
new_page,
        lac i table_pointer
        dac scene_radius
        idx table_pointer
        lac i table_pointer
        dac scene_footer
        idx table_pointer
        lac scene_radius
        add [0d512]
        dac line_end_x
        jda gframe_begin
        frame_buffer
        0d512
        jda gcircle
        0d512
        0d512
scene_radius, 0
        jda gline
        0d512
        0d512
line_end_x, 0
        0d512
        jda gplot
        0d512
        0d512
        jda gtext
        0d304
        0d840
        3
        heading
        jda gtext
        0d420
        0d140
        2
scene_footer, 0
        jsp gframe_end
        lac gf_fault
        sza
        jmp demo_fault
#ifdef DEMO_CPU_TEST
        law i 1
#else
        law i 0d120
#endif
        dac repeats
frame,
#ifndef DEMO_CPU_TEST
        iot 32
        dio frame_start
#endif
        jsp gframe_refresh
        lac gf_fault
        sza
        jmp demo_fault
#ifndef DEMO_CPU_TEST
        iot 32
        dio now_ms
        lac now_ms
        sub frame_start
        spa
        add [0d60000]
        dac draw_ms
        sub max_draw_ms
        spa
        jmp wait_frame
        lac draw_ms
        dac max_draw_ms
wait_frame,
        iot 32
        dio now_ms
        lac now_ms
        sub frame_start
        spa
        add [0d60000]
        sub [0d22]
        spa
        jmp wait_frame
#endif
        idx frames
        isp repeats
        jmp frame
        idx page
        sad [3]
        jmp restart
        jmp new_page
restart,
#ifdef DEMO_CPU_TEST
        hlt
#endif
        dzm page
        law scene_table
        dac table_pointer
        jmp new_page
demo_fault,
        law 1
        dac fault
        hlt

// Demo-only magnification of geometry, text stays in screen coordinates.
view_plot, 0
        dac view_ret
        lac i view_ret
        sub [0d512]
        sal 3s
        add [0d512]
        dac view_x
        idx view_ret
        lac i view_ret
        sub [0d512]
        sal 3s
        add [0d512]
        dac view_y
        idx view_ret
        jda gplot
view_x, 0
view_y, 0
        jmp i view_ret
view_ret, 0
frames, 0
page, 0
repeats, 0
fault, 0
frame_start, 0
now_ms, 0
draw_ms, 0
max_draw_ms, 0
table_pointer, 0
scene_table,
        0d12; footer_one
        0d16; footer_two
        0d20; footer_three
heading, ascii "P1GL GRAPHICS"
footer_one, ascii "FRAME 1"
footer_two, ascii "FRAME 2"
footer_three, ascii "FRAME 3"
#define gplot view_plot
#include "../src/gcircle.am1"
#include "../src/gline.am1"
#undef gplot
#include "../src/gplot.am1"
#include "../src/gframe.am1"
#include "../src/gtext.am1"
constants
frame_buffer, 0
frame_buffer + 0d512/
buffer_guard, 0123456
assert . < 07751, "frame demo exceeds one bank or loader space"
start go
