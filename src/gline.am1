// Native Type 340 G_LINE: bounded vector segments, exact endpoints.
// Bresenham state chooses segment endpoints; the 340 draws each segment.
// jda gline; X0_VALUE; Y0_VALUE; X1_VALUE; Y1_VALUE (literal integers).
// Same-bank, non-reentrant, writable code; AC and IO clobbered.
// Caller guarantees each coordinate is 0..1023; no clipping.
// Error terms are bounded by +/-2046, well inside signed 18-bit range.
#include "type340.ah"
gline, 0
        dac gl_ret
        lac i gl_ret
        dac gl_x
        idx gl_ret
        lac i gl_ret
        dac gl_y
        idx gl_ret
        lac i gl_ret
        dac gl_xend
        idx gl_ret
        lac i gl_ret
        dac gl_yend
        idx gl_ret

        jsp gf_enter
        dzm gl_steps
        lac gl_x
        dac gl_lastx
        lac gl_y
        dac gl_lasty
        lac gl_xend
        sub gl_x
        spa
        jmp gl_xnegative
        dac gl_dx
        law 1
        dac gl_sx
        jmp gl_ysetup
gl_xnegative,
        cma
        dac gl_dx
        law i 1
        dac gl_sx
gl_ysetup,
        lac gl_yend
        sub gl_y
        spa
        jmp gl_ynegative
        dac gl_dy
        law 1
        dac gl_sy
        jmp gl_error
gl_ynegative,
        cma
        dac gl_dy
        law i 1
        dac gl_sy
gl_error,
        lac gl_dx
        sub gl_dy
        dac gl_err

gl_start,
        lac gl_x
        dac gl_plotx
        lac gl_y
        dac gl_ploty
        jda gplot
gl_plotx, 0
gl_ploty, 0
gl_loop,
        lac gl_x
        sas gl_xend
        jmp gl_advance
        lac gl_y
        sas gl_yend
        jmp gl_advance
        lac gl_steps
        sza
        jsp gl_emit
        jsp gf_leave
        jmp i gl_ret

gl_advance,
        lac gl_err
        sal 1s
        dac gl_e2          // retain original e2 for BOTH comparisons
        add gl_dy
        sma sza            // step X iff e2 > -dy (strict inequality)
        jmp gl_stepx
        jmp gl_testy
gl_stepx,
        lac gl_err
        sub gl_dy
        dac gl_err
        lac gl_x
        add gl_sx
        dac gl_x
gl_testy,
        lac gl_e2
        sub gl_dx
        add [0]            // canonicalize zero before strict sign test
        sma                // step Y iff e2 < dx (strict inequality)
        jmp gl_step_done
        lac gl_err
        add gl_dx
        dac gl_err
        lac gl_y
        add gl_sy
        dac gl_y
        jmp gl_step_done

gl_ret, 0
gl_x, 0
gl_y, 0
gl_xend, 0
gl_yend, 0
gl_dx, 0
gl_dy, 0
gl_sx, 0
gl_sy, 0
gl_err, 0
gl_e2, 0

gl_step_done,
        idx gl_steps
        sad [0d127]
        jmp gl_segment
        jmp gl_loop
gl_segment,
        jsp gl_emit
        dzm gl_steps
        jmp gl_loop

// Current and last emitted endpoints differ by at most 127 on each axis.
// Each group starts/ends in POINT mode, allowing safe immediate chunking.
gl_emit,
        dap gl_emit_ret
        law 4
        dac gf_need
        jsp gf_reserve
        lac gf_fault
        sza
        jmp gl_emit_ret
        lac [T_VISIBLE | T_END]
        dac gl_word
        lac gl_x
        sub gl_lastx
        spa
        jmp gl_left
        jmp gl_dxword
gl_left,
        cma
        dac gl_temp
        lac gl_word
        ior [0200]
        dac gl_word
        lac gl_temp
gl_dxword,
        ior gl_word
        dac gl_word
        lac gl_y
        sub gl_lasty
        spa
        jmp gl_down
        jmp gl_dyword
gl_down,
        cma
        dac gl_temp
        lac gl_word
        ior [0100000]
        dac gl_word
        lac gl_temp
gl_dyword,
        sal 8s
        ior gl_word
        dac gl_word
        lac gl_lasty
        ior [T_Y | T_POINT]
        dac i gf_write
        idx gf_write
        lac gl_lastx
        ior [T_VECTOR]
        dac i gf_write
        idx gf_write
        lac gl_word
        dac i gf_write
        idx gf_write
        lac [T_PARAMETER | T_POINT]
        dac i gf_write
        idx gf_write
        lac gl_x
        dac gl_lastx
        lac gl_y
        dac gl_lasty
        lac gf_recording
        sza
        idx gf_vectors
gl_emit_ret, jmp .
gl_steps, 0
gl_lastx, 0
gl_lasty, 0
gl_word, 0
gl_temp, 0
